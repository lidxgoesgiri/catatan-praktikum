# Salin sebagai .env, lalu isi kedua password sebelum menjalankan Compose.
# Gunakan password acak berbeda berupa huruf dan angka (minimal 24 karakter).
# Jangan unggah .env atau menampilkan isinya dalam screenshot.
APP_PORT=80
DB_DATABASE=catatan_praktikum
DB_USERNAME=catatan_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
